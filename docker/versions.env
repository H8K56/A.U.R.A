# A.U.R.A. — non-pip component pins.
#
# Every one of these was an unpinned `git clone --depth 1` of a default branch,
# so two builds of the same Dockerfile produced different stacks. The SHAs below
# are read from the known-good aura-dev container (2026-09-14) and are what make
# a rebuild reproducible.
#
# Sourced by docker-compose as build args; see Dockerfile.

# ── Base ──────────────────────────────────────────────────────────────────
UBUNTU_VERSION=22.04            # 22.04.5 LTS (Jammy)
ROS_DISTRO=humble
GAZEBO_VERSION=11              # Gazebo Classic 11.10.2 — EOL Jan 2025 (roadmap 0.4)

# ── PX4 ───────────────────────────────────────────────────────────────────
# NOTE: this is PX4 *main* on the v1.16.0-rc line, NOT v1.14. The Dockerfile
# cloned the default branch while CLAUDE.md and the roadmap both describe the
# stack as "PX4 SITL v1.14". The running system is the authority here; the
# documentation is what is wrong. See roadmap 0.5.
PX4_AUTOPILOT_REV=7b7233587665c93fb6eb7e68d3d43035293d8af4
PX4_MSGS_REV=31147daec8fae45e0cfe265d9dfe426e7d6fcf86
PX4_ROS_COM_REV=86e9aeb20e55a4673fa8a9f1c29ea06a6c5ad1af

# ── Network simulator ─────────────────────────────────────────────────────
NS3_VERSION=3.40

# ── Trajectory optimisation ───────────────────────────────────────────────
# LBFGS-Lite is not an environment pin any more. Its single header is vendored
# at src/aura_trajectory/third_party/lbfgs-lite/ (upstream a96c50e, MIT), so the
# revision is recorded there rather than here.

# ── PyTorch ───────────────────────────────────────────────────────────────
# The frozen baseline. cu124 ships kernels for sm_50-sm_90 only, so on an
# sm_120 (Blackwell) GPU torch.cuda.is_available() returns True and then every
# kernel launch fails. train_policy's resolve_device() detects this and falls
# back to CPU. To actually train on Blackwell, override with a cu128 build on
# the modernization branch (roadmap 0.2/0.6) — do not change it here, or the
# frozen baseline stops matching the published results.
TORCH_VERSION=2.6.0
TORCHVISION_VERSION=0.21.0
TORCHAUDIO_VERSION=2.6.0
TORCH_CUDA_CHANNEL=cu124
