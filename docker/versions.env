# A.U.R.A. — non-pip component pins.
#
# Every one of these was an unpinned `git clone --depth 1` of a default branch,
# so two builds of the same Dockerfile produced different stacks. The SHAs below
# are read from the known-good aura-dev container (2026-09-14) and are what make
# a rebuild reproducible.
#
# Sourced by docker-compose as build args; see Dockerfile.

# ── Base ──────────────────────────────────────────────────────────────────
UBUNTU_VERSION=22.04            # 22.04.5 LTS (Jammy)
ROS_DISTRO=humble
GAZEBO_VERSION=11              # Gazebo Classic 11.10.2 — EOL Jan 2025 (roadmap 0.4)

# ── PX4 ───────────────────────────────────────────────────────────────────
# NOTE: this is PX4 *main* on the v1.16.0-rc line, NOT v1.14. The Dockerfile
# cloned the default branch while CLAUDE.md and the roadmap both describe the
# stack as "PX4 SITL v1.14". The running system is the authority here; the
# documentation is what is wrong. See roadmap 0.5.
PX4_AUTOPILOT_REV=7b7233587665c93fb6eb7e68d3d43035293d8af4
PX4_MSGS_REV=31147daec8fae45e0cfe265d9dfe426e7d6fcf86
PX4_ROS_COM_REV=86e9aeb20e55a4673fa8a9f1c29ea06a6c5ad1af

# ── Network simulator ─────────────────────────────────────────────────────
NS3_VERSION=3.40

# ── Trajectory optimisation ───────────────────────────────────────────────
# LBFGS-Lite is not an environment pin any more. Its single header is vendored
# at src/aura_trajectory/third_party/lbfgs-lite/ (upstream a96c50e, MIT), so the
# revision is recorded there rather than here.

# ── PyTorch ───────────────────────────────────────────────────────────────
# MODERNIZATION BRANCH (roadmap 0.6). The baseline pinned torch 2.6.0+cu124,
# which ships kernels for sm_50-sm_90 only; on an sm_120 (Blackwell) GPU such
# as the RTX 5050 torch.cuda.is_available() returned True and then every
# kernel launch failed with "no kernel image is available for execution on the
# device", so train_policy's resolve_device() fell back to CPU and training
# ran at ~54 environment steps per second.
#
# cu128 is the first CUDA channel carrying sm_120 kernels (cu126 and earlier
# do not, whatever the torch version). Verified against this host: driver
# 580.178.04, compute capability 12.0, GPU visible inside the container.
#
# 2.9.1 rather than the newest 2.11.0: a settled patch release, and nothing
# here needs 2.10+. torch.load is already called with an explicit
# weights_only=False everywhere, so the 2.6 default change does not bite.
#
# The baseline's cu124 pin is preserved at the camad-2026-baseline tag; this
# file describes the stack on *this branch*, which is what "override on the
# modernization branch" meant.
#
# cu130 also exists and would match JetPack 7.2's CUDA 13.2.1 more closely if
# hardware alignment ever argues for it. Not needed for sm_120.
TORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1
TORCHAUDIO_VERSION=2.9.1
TORCH_CUDA_CHANNEL=cu128
