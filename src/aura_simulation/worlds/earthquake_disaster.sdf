<?xml version="1.0" ?>
<!--
  A.U.R.A. Earthquake Disaster World
  
  A simplified urban environment with collapsed structures
  for disaster relief drone simulation.
  
  This is a basic SDF world — add complexity as needed
  for your Gazebo Classic or Gazebo Garden setup.
-->
<sdf version="1.6">
  <world name="earthquake_disaster">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.35 0.3 1</ambient>
            <diffuse>0.5 0.45 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════ Intact Buildings ══════ -->

    <!-- Hospital (priority zone) -->
    <model name="hospital">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 20 12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 20 12</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rescue staging area marker -->
    <model name="rescue_staging">
      <static>true</static>
      <pose>50 50 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>10</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.5 0.0 1</ambient>
            <diffuse>1.0 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════ Collapsed / Damaged Structures ══════ -->

    <!-- Collapsed building (tilted) -->
    <model name="collapsed_building_1">
      <static>true</static>
      <pose>60 40 4 0.3 0.1 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>25 15 8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>25 15 8</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.35 1</ambient>
            <diffuse>0.6 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rubble pile -->
    <model name="rubble_1">
      <static>true</static>
      <pose>-50 70 1.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 20 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 20 3</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Partially collapsed wall -->
    <model name="damaged_wall_1">
      <static>true</static>
      <pose>30 -60 3 0 0.15 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 2 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 2 6</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.7 0.65 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Metal debris (causes signal interference) -->
    <model name="metal_debris">
      <static>true</static>
      <pose>-80 -30 1 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15 15 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 15 2</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════ Tall structures (affect coverage) ══════ -->

    <model name="tower_intact">
      <static>true</static>
      <pose>-100 -80 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 8 35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 35</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="apartment_block">
      <static>true</static>
      <pose>90 -40 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 15 18</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 15 18</size></box></geometry>
          <material>
            <ambient>0.65 0.6 0.55 1</ambient>
            <diffuse>0.75 0.7 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
