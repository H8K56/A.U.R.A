<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="earthquake_city">

    <!-- ═══ Physics ═══ -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <!-- ═══ Scene ═══ -->
    <scene>
      <ambient>0.6 0.55 0.5 1</ambient>
      <background>0.45 0.4 0.35 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>3</speed>
          <direction>1.2</direction>
          <humidity>0.7</humidity>
          <mean_size>0.6</mean_size>
          <ambient>0.5 0.45 0.4 1</ambient>
        </clouds>
      </sky>
      <!-- Dusty/hazy atmosphere -->
      <fog>
        <color>0.7 0.65 0.6 1</color>
        <type>linear</type>
        <start>100</start>
        <end>500</end>
        <density>0.02</density>
      </fog>
    </scene>

    <!-- ═══ Sun — late afternoon, dramatic shadows ═══ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.8 0.65 1</diffuse>
      <specular>0.3 0.3 0.25 1</specular>
      <direction>-0.4 0.3 -0.8</direction>
    </light>

    <!-- ═══ Ground Plane ═══ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>500 500</size></plane>
          </geometry>
          <material>
            <ambient>0.4 0.35 0.3 1</ambient>
            <diffuse>0.5 0.45 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         DEPLOYMENT ZONE — where drones spawn (0,0)
         Marked with a visible landing pad
    ═══════════════════════════════════════════════════ -->
    <model name="deployment_pad">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>8</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="marking">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.5 0.0 1</ambient>
            <diffuse>1.0 0.6 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         INTACT BUILDINGS — standing structures (reference)
    ═══════════════════════════════════════════════════ -->

    <!-- Hospital (Priority Zone 1) — large, intact -->
    <model name="hospital">
      <static>true</static>
      <pose>60 40 0 0 0 0.1</pose>
      <link name="link">
        <visual name="main">
          <geometry><box><size>30 20 12</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <collision name="col"><geometry><box><size>30 20 12</size></box></geometry></collision>
        <!-- Red cross marking -->
        <visual name="cross_h">
          <pose>15.05 0 8 0 1.5708 0</pose>
          <geometry><box><size>4 1 0.1</size></box></geometry>
          <material><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name="cross_v">
          <pose>15.05 0 8 0 1.5708 1.5708</pose>
          <geometry><box><size>4 1 0.1</size></box></geometry>
          <material><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rescue Staging Area (Priority Zone 2) -->
    <model name="rescue_staging">
      <static>true</static>
      <pose>-50 -30 0 0 0 0</pose>
      <link name="link">
        <visual name="tent1">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><box><size>8 5 3</size></box></geometry>
          <material><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="tent2">
          <pose>10 0 1.5 0 0 0.2</pose>
          <geometry><box><size>8 5 3</size></box></geometry>
          <material><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
        <visual name="tent3">
          <pose>5 8 1.5 0 0 -0.1</pose>
          <geometry><box><size>8 5 3</size></box></geometry>
          <material><diffuse>0.15 0.55 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         COLLAPSED / DAMAGED BUILDINGS
    ═══════════════════════════════════════════════════ -->

    <!-- Collapsed apartment block — tilted, partially fallen -->
    <model name="collapsed_apt_1">
      <static>true</static>
      <pose>30 -20 3 0.15 0.08 0.3</pose>
      <link name="link">
        <visual name="main">
          <geometry><box><size>15 10 8</size></box></geometry>
          <material><diffuse>0.6 0.55 0.5 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><box><size>15 10 8</size></box></geometry></collision>
      </link>
    </model>

    <!-- Pancaked building — floors stacked -->
    <model name="pancaked_bldg">
      <static>true</static>
      <pose>-30 25 0 0 0 0.5</pose>
      <link name="link">
        <visual name="slab1">
          <pose>0 0 0.3 0.05 -0.03 0</pose>
          <geometry><box><size>18 12 0.5</size></box></geometry>
          <material><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
        <visual name="slab2">
          <pose>0.5 -0.3 1.2 -0.08 0.04 0.02</pose>
          <geometry><box><size>17 11 0.5</size></box></geometry>
          <material><diffuse>0.5 0.45 0.4 1</diffuse></material>
        </visual>
        <visual name="slab3">
          <pose>-0.3 0.5 2.0 0.03 -0.06 -0.01</pose>
          <geometry><box><size>16 11 0.5</size></box></geometry>
          <material><diffuse>0.52 0.47 0.42 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><box><size>18 12 2.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- Severely tilted tower -->
    <model name="tilted_tower">
      <static>true</static>
      <pose>-60 60 5 0 0.25 0.8</pose>
      <link name="link">
        <visual name="main">
          <geometry><box><size>8 8 20</size></box></geometry>
          <material><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
        <collision name="col"><geometry><box><size>8 8 20</size></box></geometry></collision>
      </link>
    </model>

    <!-- Half-collapsed warehouse -->
    <model name="collapsed_warehouse">
      <static>true</static>
      <pose>50 -60 0 0 0 -0.4</pose>
      <link name="link">
        <visual name="standing">
          <pose>-5 0 4 0 0 0</pose>
          <geometry><box><size>12 20 8</size></box></geometry>
          <material><diffuse>0.45 0.4 0.38 1</diffuse></material>
        </visual>
        <visual name="fallen_wall">
          <pose>6 0 1.5 0 0.6 0</pose>
          <geometry><box><size>12 20 0.3</size></box></geometry>
          <material><diffuse>0.45 0.4 0.38 1</diffuse></material>
        </visual>
        <visual name="roof_debris">
          <pose>3 2 2 0.1 0.3 0.2</pose>
          <geometry><box><size>10 8 0.4</size></box></geometry>
          <material><diffuse>0.4 0.38 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         RUBBLE AND DEBRIS FIELD
    ═══════════════════════════════════════════════════ -->

    <!-- Scattered concrete chunks near collapsed apt -->
    <model name="rubble_cluster_1">
      <static>true</static>
      <pose>25 -15 0 0 0 0</pose>
      <link name="link">
        <visual name="r1"><pose>0 0 0.4 0.2 0.3 0.5</pose><geometry><box><size>2.5 1.8 1.2</size></box></geometry><material><diffuse>0.55 0.5 0.45 1</diffuse></material></visual>
        <visual name="r2"><pose>3 1 0.3 0.4 -0.1 0.8</pose><geometry><box><size>1.5 2.0 0.8</size></box></geometry><material><diffuse>0.5 0.48 0.42 1</diffuse></material></visual>
        <visual name="r3"><pose>-2 2 0.25 -0.15 0.25 1.2</pose><geometry><box><size>1.8 1.2 0.6</size></box></geometry><material><diffuse>0.52 0.47 0.43 1</diffuse></material></visual>
        <visual name="r4"><pose>1 -2 0.5 0.3 0.2 0.1</pose><geometry><cylinder><radius>0.8</radius><length>1.2</length></cylinder></geometry><material><diffuse>0.48 0.44 0.4 1</diffuse></material></visual>
        <visual name="r5"><pose>4 -1 0.2 0 0 0.7</pose><geometry><box><size>3 0.6 0.4</size></box></geometry><material><diffuse>0.6 0.55 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rubble_cluster_2">
      <static>true</static>
      <pose>-35 30 0 0 0 0</pose>
      <link name="link">
        <visual name="r1"><pose>0 0 0.3 0.15 0.2 0.4</pose><geometry><box><size>2 1.5 0.8</size></box></geometry><material><diffuse>0.53 0.48 0.44 1</diffuse></material></visual>
        <visual name="r2"><pose>2 -1 0.2 0.3 0.1 0.9</pose><geometry><box><size>1.2 2.5 0.5</size></box></geometry><material><diffuse>0.5 0.46 0.41 1</diffuse></material></visual>
        <visual name="r3"><pose>-1.5 1.5 0.4 0 0.3 0</pose><geometry><cylinder><radius>0.6</radius><length>1.5</length></cylinder></geometry><material><diffuse>0.55 0.5 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Fallen power lines / poles -->
    <model name="fallen_pole_1">
      <static>true</static>
      <pose>10 30 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.15 0 1.4 0.3</pose>
          <geometry><cylinder><radius>0.15</radius><length>10</length></cylinder></geometry>
          <material><diffuse>0.4 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="fallen_pole_2">
      <static>true</static>
      <pose>-15 -45 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 0.15 0 1.35 -0.5</pose>
          <geometry><cylinder><radius>0.15</radius><length>8</length></cylinder></geometry>
          <material><diffuse>0.4 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Damaged road segments -->
    <model name="cracked_road">
      <static>true</static>
      <pose>0 -50 0.01 0 0 0</pose>
      <link name="link">
        <visual name="road">
          <geometry><box><size>80 8 0.02</size></box></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <!-- Uplift crack -->
        <visual name="crack">
          <pose>15 0 0.3 0 0 0.1</pose>
          <geometry><box><size>2 8 0.6</size></box></geometry>
          <material><diffuse>0.35 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         STANDING BUILDINGS (signal blockers / reference)
    ═══════════════════════════════════════════════════ -->

    <model name="office_1">
      <static>true</static>
      <pose>-70 -20 0 0 0 0.2</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>12 10 15</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>12 10 15</size></box></geometry></collision>
      </link>
    </model>

    <model name="office_2">
      <static>true</static>
      <pose>70 70 0 0 0 -0.3</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>10 14 10</size></box></geometry><material><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>10 14 10</size></box></geometry></collision>
      </link>
    </model>

    <model name="residential_1">
      <static>true</static>
      <pose>40 60 0 0 0 0.6</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>8 8 6</size></box></geometry><material><diffuse>0.65 0.55 0.5 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>8 8 6</size></box></geometry></collision>
      </link>
    </model>

    <model name="residential_2">
      <static>true</static>
      <pose>-45 70 0 0 0 -0.1</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>10 7 5</size></box></geometry><material><diffuse>0.7 0.6 0.55 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>10 7 5</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
